# ---- Local development --------------------------------------------------------
# Postgres connection string. Leave unset for local dev: an embedded PGlite database
# is created in ./.pglite automatically.
DATABASE_URL=

# 32+ random characters, used to sign session cookies. Required in production.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# ---- Docker / droplet deployment (docker-compose.yml) ---------------------------
# Your domain, e.g. termlink.example.com (point its DNS A record at the droplet first).
# Use ":80" to serve plain HTTP on the droplet's IP address (then set COOKIE_SECURE=false).
DOMAIN=
# Password for the bundled Postgres container (letters and digits only).
POSTGRES_PASSWORD=
# Keep "true" whenever the site is served over HTTPS.
COOKIE_SECURE=true
